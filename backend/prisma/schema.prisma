generator client {
  provider = "prisma-client-js"  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  student   Student?
  teacher   Teacher?
  createdAt DateTime @default(now())
}

model Student {
  id        String   @id @default(uuid())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  age       Int
  actions   Action[]
  sessions  Session[]
  createdAt DateTime @default(now())
}


model Teacher {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  createdAt DateTime @default(now())
}

model Action {
  id        String   @id @default(uuid())
  type      ActionType
  points    Int
  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  createdAt DateTime @default(now())
}

enum ActionType {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum UserRole {
  STUDENT
  TEACHER
}

model Session {
  id        String   @id @default(uuid())
  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  histories History[]
}

model History {
  id        String   @id @default(uuid())
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String
  action    ActionType
  points    Int
  createdAt DateTime @default(now())
}
